<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime entitlements for the Electron app and every nested binary
  (including the compiled gateway at Contents/Resources/gateway/ultrawork-gateway).
  - allow-jit / allow-unsigned-executable-memory: V8 and JavaScriptCore JIT.
  - disable-library-validation: the gateway extracts its embedded libsql .node addon to a temp file and dlopens it.
  - allow-dyld-environment-variables: Bun/Electron child processes inherit DYLD_* in some setups.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <key>com.apple.security.cs.allow-dyld-environment-variables</key>
  <true/>
</dict>
</plist>
