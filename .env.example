# The desktop app takes API keys from Settings, not from this file.
# .env is only read when you run the server directly (`bun src/server/index.ts`) and by maintainer scripts.

# Server (standalone)
FIREWORKS_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
EXA_API_KEY=

# `bun run desktop:publish`: S3-compatible bucket for release artifacts + auto-update feed
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET=
R2_PUBLIC_URL=
