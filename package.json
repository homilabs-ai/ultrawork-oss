{
  "name": "ultrawork",
  "version": "0.2.0",
  "description": "Desktop app for long-running, multi-agent tasks on your own machine",
  "license": "Apache-2.0",
  "author": "Homi AI Inc.",
  "main": "dist/main/index.cjs",
  "type": "module",
  "private": true,
  "scripts": {
    "postinstall": "bun run scripts/patch-libsql.ts",
    "desktop": "bun run scripts/desktop.ts",
    "desktop:dev": "bun run scripts/desktop-dev.ts",
    "desktop:dev:fresh": "rm -rf /tmp/ultrawork-fresh && ULTRAWORK_USER_DATA=/tmp/ultrawork-fresh bun run scripts/desktop-dev.ts",
    "desktop:build": "bun run scripts/build-electron.ts",
    "build:renderer": "vite build",
    "desktop:pack": "bun run scripts/desktop-pack.ts",
    "desktop:publish": "bun run scripts/publish-release.ts",
    "desktop:icon": "bun run scripts/build-icon.ts",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "test": "bun test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/renderer",
    "lint": "biome check --error-on-warnings . && oxlint --deny-warnings src/renderer",
    "format": "biome check --write ."
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "^0.0.76",
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@mastra/core": "^1.57.0",
    "@mastra/libsql": "1.14.1",
    "@mastra/mcp": "^1.17.2",
    "@mastra/memory": "^1.21.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.18",
    "@xyflow/react": "^12.11.2",
    "ai": "^7.0.41",
    "chrome-devtools-mcp": "^1.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "d3-hierarchy": "^3.1.2",
    "drizzle-orm": "^0.45.2",
    "electron-updater": "^6.8.9",
    "exa-js": "^2.14.0",
    "hono": "^4.12.30",
    "lucide-react": "^1.25.0",
    "motion": "^13.3.0",
    "nanoid": "^6.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.2",
    "shadcn": "^4.14.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "use-stick-to-bottom": "^1.1.6",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@biomejs/biome": "^2.5.1",
    "@libsql/client": "^0.17.4",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tanstack/router-plugin": "^1.168.23",
    "@types/babel__core": "^7.20.5",
    "@types/bun": "^1.3.14",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "drizzle-kit": "^0.31.10",
    "electron": "^45",
    "electron-builder": "^26",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
